{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".pipeline",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["pipeline/**/*.ts", "crawler/**/*.ts"],
  "exclude": ["**/*.test.ts", "node_modules", ".pipeline"]
}
