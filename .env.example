# Supabase public reader (existing publishable key or legacy anon key)
# The variable name remains ANON_KEY for application compatibility.
NEXT_PUBLIC_SUPABASE_URL=https://zhaxcgvzdkhigtshcubj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (required for admin writes and retention; server-only, never public)
SUPABASE_SERVICE_ROLE_KEY=

# Admin observatory (/admin) — HTTP Basic Auth, server-only
# Generate the hash without touching history:
#   ADMIN_PASSWORD='...' npm run admin:hash
ADMIN_USERNAME=
ADMIN_PASSWORD_SHA256=

# PostgreSQL connection for offline pipeline commands and GitHub Actions only.
# Use the project's Connect dialog; never prefix this variable NEXT_PUBLIC_.
# Pipeline commands read process environment, not .env.local automatically.
DATABASE_URL=
# Optional Python executable (defaults to python).
PYTHON_BIN=
