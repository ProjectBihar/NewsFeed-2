# Supabase (public, anon — safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — never commit real values)
SUPABASE_SERVICE_ROLE_KEY=

# Admin observatory (/admin) — HTTP Basic Auth, server-only
# Generate the hash without touching history:
#   ADMIN_PASSWORD='...' npm run admin:hash
ADMIN_USERNAME=
ADMIN_PASSWORD_SHA256=
