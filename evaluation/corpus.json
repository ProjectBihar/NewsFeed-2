    {
      "id": "story",
      "path": "intelligence/clustering/tests/fixtures/story-clusters.json",
      "kind": "story-partition",
      "coverage": ["multi-publisher", "cross-language", "singletons", "time-separated"]
    },
    {
      "id": "xlingual",
      "path": "intelligence/clustering/tests/fixtures/xlingual-cases.json",
      "kind": "xl-pairs",
      "coverage": ["hindi-english", "transliteration", "shared-numbers", "must-not-merge"]
    }
  ],
  "thresholds": {
    "relevance_precision": 0.9,
    "relevance_recall": 0.9,
    "curated_precision": 0.9,
    "curated_recall": 0.9,
    "article_type_macro_f1": 0.9,
    "category_macro_f1": 0.9,
    "event_accuracy": 0.9,
    "event_macro_f1": 0.9,
    "cluster_precision": 0.9,
    "cluster_recall": 0.9,
    "extraction_success_rate": 0.9
  }
}
